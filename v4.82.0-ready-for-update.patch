diff --git a/css/style.css b/css/style.css
index ee196c2..bdf1c73 100644
--- a/css/style.css
+++ b/css/style.css
@@ -4683,3 +4683,22 @@ span.mm-hero-client{cursor:default}
   .issues-block .plan-issue-row .pi-cl,.issues-block .plan-issue-row .pi-cat{grid-column:2}
   .plan-issue-row.pi-cols{display:none}
 }
+
+/* ============================================================
+   v4.82.0 — "Ready for update": the newest update of each product (installer is built)
+   ============================================================ */
+.up-ready{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:800;letter-spacing:.03em;padding:2px 10px;border-radius:999px;background:var(--success-soft);color:var(--success);white-space:nowrap}
+.up-ready i{width:7px;height:7px;border-radius:50%;background:currentColor;animation:upReadyPulse 2.2s ease-out infinite}
+.up-ready.is-sm{font-size:10px;padding:1px 8px;margin-bottom:3px}
+.up-lcard-top .up-ready{display:flex;width:max-content}
+.up-earlier{font-size:11px;font-weight:650;padding:2px 9px;border-radius:999px;background:var(--bg-subtle);color:var(--text-secondary);white-space:nowrap}
+.up-ready-note{margin:0 0 10px;padding:9px 12px;border-radius:var(--r-md);background:var(--success-soft);color:var(--success);font-size:12.5px;font-weight:600}
+.up-answer-ready{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:6px}
+.up-stage{display:inline-flex;padding:3px;border:1px solid var(--line);border-radius:999px;background:var(--surface)}
+.up-stage-btn{border:0;background:transparent;color:var(--text-secondary);font:inherit;font-size:12.5px;font-weight:650;padding:6px 12px;border-radius:999px;cursor:pointer;white-space:nowrap}
+.up-stage-btn.is-active{background:var(--text);color:var(--surface)}
+.summary-ready{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:800;padding:2px 10px;border-radius:999px;background:var(--success-soft);color:var(--success);white-space:nowrap}
+.summary-ready i{width:7px;height:7px;border-radius:50%;background:currentColor;animation:upReadyPulse 2.2s ease-out infinite}
+@keyframes upReadyPulse{0%{box-shadow:0 0 0 0 color-mix(in srgb,currentColor 55%,transparent)}70%,100%{box-shadow:0 0 0 7px transparent}}
+@media (prefers-reduced-motion:reduce){.up-ready i,.summary-ready i{animation:none}}
+@media (max-width:760px){.up-stage{width:100%;overflow-x:auto}.up-stage-btn{flex:1}}
