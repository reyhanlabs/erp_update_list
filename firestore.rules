rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cron / system state — server only (firebase-admin bypasses rules).
    match /system/{document} {
      allow read, write: if false;
    }

    // Public plan shares — short links for SDET (read-only for anyone)
    match /shares/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['v', 'title', 'issues', 'createdAt'])
        && request.resource.data.issues is list
        && request.resource.data.issues.size() <= 500;
      allow update, delete: if false;
    }

    // Team workspaces — the workspace code is the shared secret, so it must
    // never be listable/enumerable. Only direct get by id is allowed.
    match /workspaces/{workspaceId} {
      allow get, write: if request.auth != null;
      allow list: if false;

      match /plans/{planId} {
        allow read, write: if request.auth != null;
      }
      match /summaries/{summaryId} {
        allow read, write: if request.auth != null;
      }
      // Knowledge Base guides + their screenshots (v4.42.0)
      match /kb/{articleId} {
        allow read, write: if request.auth != null;
        match /images/{imageId} {
          allow read, delete: if request.auth != null;
          allow create, update: if request.auth != null
            && request.resource.data.data is string
            && request.resource.data.data.size() < 1000000
            && request.resource.data.data.matches('^data:image/(png|jpeg|webp|gif);base64,.*');
        }
      }
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /plans/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /summaries/{summaryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
